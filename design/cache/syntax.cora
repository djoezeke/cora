// ---------------------------------------------------------------------------
// Generics
// ---------------------------------------------------------------------------

// Generic Function `func sort<T>(v: T[]) -> T[];`

func getMax<T>(a: T, b: T) -> T {
    return (a > b) ? a : b;
}

// Generic Type/Struct `struct vector<T>;` 

struct Box<T> {
    v: T,

    pub func Box(value: T) -> Box<T> {
        return{
            v: value,
        }
    }

    func getValue() -> const T { return v; }
};

// ============================================================================
// Concept
// ============================================================================

// Defining a custom concept using a requires expression
comptime func Integral<T>(type: T){
    return is_integral<T>(type);
}

comptime func is_integral<T>(t: T) -> bool {
    return false;
}

comptime func is_integral<u32>(){
    return true;
}

// ============================================================================
// Constraint
// ============================================================================

// Restricts T to types that support standard arithmetic addition
func add<T: Integral>(a: T, b: T) -> T {
    return a + b;
}

