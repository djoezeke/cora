// ---------------------------------------------------------------------------
// Function types, closures, and higher-order functions
// ---------------------------------------------------------------------------

pub func make_adder(delta: i32) -> Callback {
    return func(value: i32, context: *mut void) -> i32 {
        return value + delta;
    };
}

pub func apply_twice(value: i32, operation: Callback) -> i32 {
    return operation(operation(value, null), null);
}

[[nodiscard("the clamped value must be used")]]
pub func clamp_value(value: i32, lower: i32, upper: i32) -> i32 {
    return (value < lower) ? lower : ((value > upper) ? upper : value);
}

[[deprecated("use clamp_value instead")]]
pub func clamp_legacy(value: i32) -> i32 {
    return clamp_value(value, 0, 100);
}

@inline
pub func parse_port(text: &str) -> Result<u16, str> {
    if (text.len() == 0) {
        return Result<u16, str>::Err("empty port");
    }
    return Result<u16, str>::Ok(8080);
}

// ---------------------------------------------------------------------------
// Compile-time evaluation and generic packs
// ---------------------------------------------------------------------------

comptime func factorial(n: u64) -> u64 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

comptime func nth<I: usize, Args: ...type>(args: Args...) -> Args...[I] {
    return args...[I];
}

const FACT_10: u64 = constexpr factorial(10);

comptime func enum_name<E>(value: E) -> str {
    for (comptime enumerator : meta::enumerators_of(^^E)) {
        if (meta::value_of(enumerator) == value) {
            return meta::identifier_of(enumerator);
        }
    }
    return "unknown";
}

// ---------------------------------------------------------------------------
// Static reflection and structured annotations
// ---------------------------------------------------------------------------

pub comptime struct Skip {}

pub comptime struct Rename {
    pub name: str,
}

pub comptime struct FieldInfo {
    pub name: str,
    pub type_name: str,
    pub borrowed: bool,
}

comptime func has_skip(member: meta::info) -> bool {
    return !meta::annotations_of(member, ^^Skip).empty();
}

comptime func json_key(member: meta::info) -> str {
    let renames := meta::annotations_of(member, ^^Rename);
    if (renames.empty()) {
        return meta::identifier_of(member);
    }
    return meta::extract<Rename>(renames.front()).name;
}

comptime func reflect_fields<T>() -> FieldInfo[] {
    mut fields: FieldInfo[] = [];

    expand (comptime member : meta::nonstatic_data_members_of(^^T)) {
        fields.push(FieldInfo {
            name: meta::identifier_of(member),
            type_name: meta::display_name_of(meta::type_of(member)),
            borrowed: meta::is_reference_type(meta::type_of(member)),
        });
    }

    return fields;
}

comptime func serialize<T>(value: &T) -> str {
    mut out := "{";
    mut first := true;

    for (comptime member : meta::nonstatic_data_members_of(^^T)) {
        comptime if (!has_skip(member)) {
            if (!first) {
                out += ", ";
            }
            first = false;
            out += "\"";
            out += json_key(member);
            out += "\": ";
            out += to_json(value.[:member:]);
        }
    }

    return out + "}";
}

comptime func to_json<T>(value: &T) -> str {
    if (cora::is_same_v<T, str>) {
        return "\"" + value + "\"";
    }
    return serialize(value);
}

pub comptime func account_fields() -> FieldInfo[] {
    return reflect_fields<Account>();
}

// ---------------------------------------------------------------------------
// Macros and meta programming
// ---------------------------------------------------------------------------

pub concept JsonSerializable<T>(t: const T) {
    { t.speak() } -> str;
};

macro clamp!(value, lower, upper) =>
    ((value < lower) ? lower : ((value > upper) ? upper : value));

macro attribute derive_json(comptime target: type) {
    impl JsonSerializable for target {
        func(self: &target) to_json() -> str {
            return serialize(self);
        }
    }
}

macro to_json(t: JsonSerializable) t.to_json()

pub struct Account {
    pub id: u32,

    [[=Rename("user_name")]]
    pub username: str,

    [[=Skip()]]
    pub password_hash: str,

    func(a: &Account) to_json() -> str {
        return serialize(a);
    }
}

// ---------------------------------------------------------------------------
// Statements, control flow, jumps, and defer
// ---------------------------------------------------------------------------

pub func control_flow_demo(input: i32) -> i32 {
    mut total := 0;

    if (input < 0) {
        total -= input;
    } else if (input == 0) {
        total = 1;
    } else {
        total = input;
    }

    mut i := 0;
    while (i < 3) {
        total += i;
        i += 1;
    }

    do {
        total += 1;
    } while (total < 5);

    for (mut j: i32 = 0; j < 2; j += 1) {
        total += j;
    }

    let values := [10, 20, 30];
    for (value : values) {
        total += value;
    }

    for (entry in values) {
        total += entry;
    }

    switch (input) {
        case 0:
            total += 1;
            fallthrough;
        case 1, 2, 3:
            total += 2;
            break;
        default:
            total += 3;
    }

    let label := match (total) {
        0 => "zero",
        1..=9 => "small",
        _ => "large",
    };

    outer: for (mut k: i32 = 0; k < 2; k += 1) {
        for (mut m: i32 = 0; m < 2; m += 1) {
            if (m == 1) {
                continue outer;
            }
            if (k == 1) {
                break outer;
            }
        }
    }

    [[unlikely]]
    if (total < 0) {
        goto cleanup;
    }

    defer println("control_flow_demo done");

    return total;

cleanup:
    return 0;
}

pub func unsafe_demo(size: usize) -> usize {
    let raw := memory::alloc(size) as *mut u8;

    unsafe {
        *raw = 0x2A;
        let value := *raw as usize;
        memory::dealloc(raw as *mut void);
        return value;
    }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

pub func main() -> i32 {
    let point := Point { x: 3.0, y: 4.0 };
    let origin := geometry::origin();
    let distance := geometry::distance(point, origin);

    let values := [1, 2, 3, 4, 5];
    let total := sum_all(values);
    let largest := clamp!(total, 0, MAX_RETRIES as i32);

    mut stack := Stack<i32>::init(8);
    stack.push(largest);
    let top := stack.peek();

    mut buffer := Buffer::with_capacity(64);
    let shared_size := inspect(&buffer);
    let written := mutate(&mut buffer);
    let moved := move buffer;
    let moved_size := inspect(&moved);
    let owned_again := forward(moved);
    let consumed := consume(owned_again);

    let account := Account {
        id: 1,
        username: "grace_hopper",
        password_hash: "s3cr3t_h4sh",
    };
    let json := to_json(&account);

    let parsed := parse_port("8080");
    let port := match (parsed) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            diagnostics::report(1, message);
            0
        },
    };

    let maybe_name: str? = null;
    let display_name := maybe_name ?? "anonymous";

    let block_value := {
        mut sum := 0;
        for (value : values) {
            sum += value;
        }
        sum
    };

    let sign := if (distance > 0.0) {
        1
    } else if (distance < 0.0) {
        -1
    } else {
        0
    };

    let double := |value: i32| value * 2;
    let doubled := double(block_value);

    let adder := make_adder(7);
    let applied := adder(35, null);
    let twice := apply_twice(5, adder);

    let safe := unsafe_demo(16);
    let second := comptime nth<1>(10, 20, 30);
    let enum_text := comptime enum_name<Ordering>(Ordering::Greater);

    static_assert(sizeof(Ordering) == 1, "Ordering must be byte-sized");

    comptime {
        static_assert(FACT_10 == 3628800,
                      "factorial is evaluated at compile time");
        println("compile-time checks complete");
    }

    println("version: ", VERSION);
    println("distance: ", distance);
    println("total: ", total);
    println("largest: ", largest);
    println("top: ", top);
    println("shared size: ", shared_size);
    println("written: ", written);
    println("moved size: ", moved_size);
    println("consumed: ", consumed);
    println("json: ", json);
    println("port: ", port);
    println("name: ", display_name);
    println("block: ", block_value);
    println("sign: ", sign);
    println("doubled: ", doubled);
    println("applied: ", applied);
    println("twice: ", twice);
    println("safe: ", safe);
    println("second: ", second);
    println("enum: ", enum_text);
    println("fields: ", account_fields().len());
    println("control: ", control_flow_demo(-3));

    return 0;
}


