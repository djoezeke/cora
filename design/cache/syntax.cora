import <stdio.h>;

pub func print(msg: u8[]) -> void {
    unsafe {
        printf("%s\n",msg);
    }
}

// ---------------------------------------------------------------------------
// Compile time Function
// ---------------------------------------------------------------------------

/*!
 * @brief Align a value up.
 * @param v the value.
 * @param a alignment
 */
comptime func align(v: usize, a: usize) -> usize {
    return ((v + a - 1) && !(a - 1));
}

const HEADER_SIZE = align(13,8);

comptime func fib(n: u32) -> u32 {
    if (n < 2){ 
        return n; 
    } else {
        return fib(n - 1) + fib(n - 2); 
    }
}

// ---------------------------------------------------------------------------
// Procedural Macro
// ---------------------------------------------------------------------------

macro func square(x: Expr<i32>) -> Expr<i32> {
    quote!{ { let t = $x; t * t } }         // `t` is hygienic
}

let n := square!(3 + 1);                     // 16, not 3 + 1 * 3 + 1

macro func make_getters(input: Syntax) -> Syntax {
    let fields = reflect(input).fields;
    syntax {
        $(for field in fields {
            pub fn $(field.name)(self: &Self) -> $(field.type) {
                self.$(field.name)
            }
        })
    }
}

// ---------------------------------------------------------------------------
// Modules/Namespaces
// ---------------------------------------------------------------------------

pub mod geometry {
    [[repr(C)]]
    pub struct Point {
        pub x: f64,
        pub y: f64,
    }

    pub func origin() -> Point {
        return Point { x: 0.0, y: 0.0 };
    }

    mod details {
        pub func distance(a: &Point, b: &Point) -> f64 {
            let dx := a.x - b.x;
            let dy := a.y - b.y;
            return std::math::sqrt(dx * dx + dy * dy);
        }
    }
}

pub mod diagnostics::details {
    pub func report(code: i32, message: &str) -> void {
        std::io::write_err(code, message);
    }
}

