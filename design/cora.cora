// `$x:fragment` specifiers are mandatory for captures.
// Hygiene is the default; call-site identifiers cannot be captured.
macro vec {
    ($($x:expr),* $(,)?) => {
        {
            let mut temp = Vec::new();
            $( temp.push($x); )*
            temp
        }
    };
}

mod det::ail { 
    [[nodiscard]] func id() -> i32 {
        return 32; 
    }
};

