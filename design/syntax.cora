//! # Cora syntax showcase
//!
//! This translation unit exercises every major syntactic feature of Cora:
//! declarations, modules, imports, generics, traits, ownership and borrowing,
//! attributes and annotations, macros, compile-time evaluation, static
//! reflection, expansion statements, selection, iteration, jumps, and a wide
//! range of expressions.
//!
//! It is written to be parsed by the grammar in `design/grammer.ebnf`.

import (
    std::fmt::{print, println};
    std::io;
    std::math;
    std::meta;
    std::memory;
);

using geometry::Point;
using ByteStack = Stack<u8>;

@define(MAX_RETRIES, 3);

// ---------------------------------------------------------------------------
// Modules
// ---------------------------------------------------------------------------

pub mod geometry {
    [[repr(C)]]
    pub struct Point {
        pub x: f64,
        pub y: f64,
    }

    pub func origin() -> Point {
        return Point { x: 0.0, y: 0.0 };
    }

    pub func distance(a: &Point, b: &Point) -> f64 {
        let dx := a.x - b.x;
        let dy := a.y - b.y;
        return std::math::sqrt(dx * dx + dy * dy);
    }
}

pub mod diagnostics {
    pub func report(code: i32, message: &str) -> void {
        std::io::write_err(code, message);
    }
}

// ---------------------------------------------------------------------------
// Constants and type aliases
// ---------------------------------------------------------------------------

pub const VERSION: str = "Cora 1.0";
pub static const MAX_ATTEMPTS: u32 = 3;

pub type StudentId = u32;
pub type Callback = func(value: i32, context: *mut void) -> i32;

pub type InlinePoint = struct {
    x: i32,
    y: i32,
};

pub type Pair<T> = struct {
    first: T,
    second: T,
};

// ---------------------------------------------------------------------------
// Enums, unions, and pattern-driven data types
// ---------------------------------------------------------------------------

pub enum Ordering : i8 {
    Less = -1,
    Equal = 0,
    Greater = 1,
}

pub enum Option<T> {
    None,
    Some(T),
}

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub union Storage {
    integer: i64,
    pointer: *mut u8,
    bytes: u8[16],
}

pub enum Token {
    Identifier(str),
    Integer(i64),
    Float(f64),
    End,
}

// ---------------------------------------------------------------------------
// Traits, concepts, and interfaces
// ---------------------------------------------------------------------------

pub trait Shape {
    type Scalar = f64;

    func(self: &Self) area() -> Scalar;

    func(self: &Self) name() -> str {
        return "shape";
    }
}

pub trait JsonSerializable {
    func(self: &Self) to_json() -> str;
}

pub concept Comparable<T> = requires(self: &T, other: &T) {
    { self.compare(other) } -> Ordering;
};

pub interface Reader {
    func(self: &mut Self) read(buffer: &mut [u8]) -> usize;
    func(self: &mut Self) close() -> void;
}

// ---------------------------------------------------------------------------
// Concrete implementations
// ---------------------------------------------------------------------------

[[repr(C)]]
pub struct Rect {
    pub width: u32,
    pub height: u32,
}

pub impl Shape for Rect {
    func(self: &Rect) area() -> f64 {
        return (self.width * self.height) as f64;
    }

    func(self: &Rect) name() -> str {
        return "rectangle";
    }
}

pub struct FileReader : Reader {
    fd: i32,
}

pub impl Reader for FileReader {
    func(self: &mut FileReader) read(buffer: &mut [u8]) -> usize {
        if (buffer.len() == 0) {
            return 0;
        }
        return std::io::read(self.fd, buffer);
    }

    func(self: &mut FileReader) close() -> void {
        std::io::close(self.fd);
    }
}

// ---------------------------------------------------------------------------
// Generic containers
// ---------------------------------------------------------------------------

pub struct Stack<T> {
    items: T[],
    capacity: usize,
}

impl<T> Stack<T> {
    pub func init(capacity: usize) -> Stack<T> {
        return Stack<T> {
            items: [],
            capacity: capacity,
        };
    }

    pub func(self: &mut Stack<T>) push(value: T) -> void {
        if (self.items.len() == self.capacity) {
            self.grow();
        }
        self.items.push(value);
    }

    pub func(self: &mut Stack<T>) pop() -> Option<T> {
        if (self.items.len() == 0) {
            return Option<T>::None;
        }

        let index := self.items.len() - 1;
        let value := self.items[index];
        self.items.truncate(index);
        return Option<T>::Some(value);
    }

    pub func(self: &Stack<T>) peek() -> Option<&T> {
        if (self.items.len() == 0) {
            return Option<&T>::None;
        }
        return Option<&T>::Some(&self.items[self.items.len() - 1]);
    }

    func(self: &mut Stack<T>) grow() -> void {
        self.capacity = self.capacity * 2;
        self.items.reserve(self.capacity);
    }
}

// ---------------------------------------------------------------------------
// Lifetimes, borrows, and ownership
// ---------------------------------------------------------------------------

pub func first<'a, T>(items: &'a [T]) -> &'a T {
    return &items[0];
}

pub func max_of<T: Comparable<T>>(items: &[T]) -> &T where T: Copy {
    mut best := &items[0];

    for (item : items[1..]) {
        if (item.compare(best) == Ordering::Greater) {
            best = item;
        }
    }

    return best;
}

pub func sum_all(items: &[i32]) -> i32 {
    mut total := 0;
    for (value : items) {
        total += value;
    }
    return total;
}

pub struct Buffer {
    data: u8[],
    len: usize,
}

impl Buffer {
    pub func with_capacity(capacity: usize) -> own Buffer {
        return own Buffer {
            data: memory::alloc_array<u8>(capacity),
            len: 0,
        };
    }

    pub func(self: &Buffer) size() -> usize {
        return self.len;
    }

    pub func(self: &mut Buffer) write(data: &[u8]) -> usize {
        let available := self.data.len() - self.len;
        let count := if (data.len() < available) { data.len() } else { available };

        for (mut i: usize = 0; i < count; i += 1) {
            self.data[self.len + i] = data[i];
        }

        self.len += count;
        return count;
    }
}

pub func inspect(borrow buffer: &Buffer) -> usize {
    return buffer.size();
}

pub func mutate(value: &mut Buffer) -> usize {
    return value.write(&[0x43, 0x4F, 0x52, 0x41]);
}

pub func consume(own buffer: Buffer) -> usize {
    return buffer.size();
}

pub func forward(value: own Buffer) -> Buffer {
    return move value;
}

// ---------------------------------------------------------------------------
// Function types, closures, and higher-order functions
// ---------------------------------------------------------------------------

pub func make_adder(delta: i32) -> Callback {
    return func(value: i32, context: *mut void) -> i32 {
        return value + delta;
    };
}

pub func apply_twice(value: i32, operation: Callback) -> i32 {
    return operation(operation(value, null), null);
}

[[nodiscard("the clamped value must be used")]]
pub func clamp_value(value: i32, lower: i32, upper: i32) -> i32 {
    return (value < lower) ? lower : ((value > upper) ? upper : value);
}

[[deprecated("use clamp_value instead")]]
pub func clamp_legacy(value: i32) -> i32 {
    return clamp_value(value, 0, 100);
}

@inline
pub func parse_port(text: &str) -> Result<u16, str> {
    if (text.len() == 0) {
        return Result<u16, str>::Err("empty port");
    }
    return Result<u16, str>::Ok(8080);
}

// ---------------------------------------------------------------------------
// Compile-time evaluation and generic packs
// ---------------------------------------------------------------------------

comptime func factorial(n: u64) -> u64 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

comptime func nth<I: usize, Args: ...type>(args: Args...) -> Args...[I] {
    return args...[I];
}

const FACT_10: u64 = constexpr factorial(10);

comptime func enum_name<E>(value: E) -> str {
    for (comptime enumerator : meta::enumerators_of(^^E)) {
        if (meta::value_of(enumerator) == value) {
            return meta::identifier_of(enumerator);
        }
    }
    return "unknown";
}

// ---------------------------------------------------------------------------
// Static reflection and structured annotations
// ---------------------------------------------------------------------------

pub comptime struct Skip {}

pub comptime struct Rename {
    pub name: str,
}

pub comptime struct FieldInfo {
    pub name: str,
    pub type_name: str,
    pub borrowed: bool,
}

comptime func has_skip(member: meta::info) -> bool {
    return !meta::annotations_of(member, ^^Skip).empty();
}

comptime func json_key(member: meta::info) -> str {
    let renames := meta::annotations_of(member, ^^Rename);
    if (renames.empty()) {
        return meta::identifier_of(member);
    }
    return meta::extract<Rename>(renames.front()).name;
}

comptime func reflect_fields<T>() -> FieldInfo[] {
    mut fields: FieldInfo[] = [];

    expand (comptime member : meta::nonstatic_data_members_of(^^T)) {
        fields.push(FieldInfo {
            name: meta::identifier_of(member),
            type_name: meta::display_name_of(meta::type_of(member)),
            borrowed: meta::is_reference_type(meta::type_of(member)),
        });
    }

    return fields;
}

comptime func serialize<T>(value: &T) -> str {
    mut out := "{";
    mut first := true;

    expand (comptime member : meta::nonstatic_data_members_of(^^T)) {
        comptime if (!has_skip(member)) {
            if (!first) {
                out += ", ";
            }
            first = false;
            out += "\"";
            out += json_key(member);
            out += "\": ";
            out += to_json(value.[:member:]);
        }
    }

    return out + "}";
}

comptime func to_json<T>(value: &T) -> str {
    if (cora::is_same_v<T, str>) {
        return "\"" + value + "\"";
    }
    return serialize(value);
}

pub comptime func account_fields() -> FieldInfo[] {
    return reflect_fields<Account>();
}

// ---------------------------------------------------------------------------
// Macros and meta programming
// ---------------------------------------------------------------------------

macro clamp!(value, lower, upper) =>
    ((value < lower) ? lower : ((value > upper) ? upper : value));

macro attribute derive_json(comptime target: type) {
    impl JsonSerializable for target {
        func(self: &target) to_json() -> str {
            return serialize(self);
        }
    }
}

@derive_json
pub struct Account {
    pub id: u32,

    [[=Rename("user_name")]]
    pub username: str,

    [[=Skip()]]
    pub password_hash: str,
}

// ---------------------------------------------------------------------------
// Statements, control flow, jumps, and defer
// ---------------------------------------------------------------------------

pub func control_flow_demo(input: i32) -> i32 {
    mut total := 0;

    if (input < 0) {
        total -= input;
    } else if (input == 0) {
        total = 1;
    } else {
        total = input;
    }

    mut i := 0;
    while (i < 3) {
        total += i;
        i += 1;
    }

    do {
        total += 1;
    } while (total < 5);

    for (mut j: i32 = 0; j < 2; j += 1) {
        total += j;
    }

    let values := [10, 20, 30];
    for (value : values) {
        total += value;
    }

    for (entry in values) {
        total += entry;
    }

    switch (input) {
        case 0:
            total += 1;
            fallthrough;
        case 1, 2, 3:
            total += 2;
            break;
        default:
            total += 3;
    }

    let label := match (total) {
        0 => "zero",
        1..=9 => "small",
        _ => "large",
    };

    outer: for (mut k: i32 = 0; k < 2; k += 1) {
        for (mut m: i32 = 0; m < 2; m += 1) {
            if (m == 1) {
                continue outer;
            }
            if (k == 1) {
                break outer;
            }
        }
    }

    [[unlikely]]
    if (total < 0) {
        goto cleanup;
    }

    defer println("control_flow_demo done");

    return total;

cleanup:
    return 0;
}

pub func unsafe_demo(size: usize) -> usize {
    let raw := memory::alloc(size) as *mut u8;

    unsafe {
        *raw = 0x2A;
        let value := *raw as usize;
        memory::dealloc(raw as *mut void);
        return value;
    }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

pub func main() -> i32 {
    let point := Point { x: 3.0, y: 4.0 };
    let origin := geometry::origin();
    let distance := geometry::distance(point, origin);

    let values := [1, 2, 3, 4, 5];
    let total := sum_all(values);
    let largest := clamp!(total, 0, MAX_RETRIES as i32);

    mut stack := Stack<i32>::init(8);
    stack.push(largest);
    let top := stack.peek();

    mut buffer := Buffer::with_capacity(64);
    let shared_size := inspect(&buffer);
    let written := mutate(&mut buffer);
    let moved := move buffer;
    let moved_size := inspect(&moved);
    let owned_again := forward(moved);
    let consumed := consume(owned_again);

    let account := Account {
        id: 1,
        username: "grace_hopper",
        password_hash: "s3cr3t_h4sh",
    };
    let json := to_json(&account);

    let parsed := parse_port("8080");
    let port := match (parsed) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            diagnostics::report(1, message);
            0
        },
    };

    let maybe_name: str? = null;
    let display_name := maybe_name ?? "anonymous";

    let block_value := {
        mut sum := 0;
        for (value : values) {
            sum += value;
        }
        sum
    };

    let sign := if (distance > 0.0) {
        1
    } else if (distance < 0.0) {
        -1
    } else {
        0
    };

    let double := |value: i32| value * 2;
    let doubled := double(block_value);

    let adder := make_adder(7);
    let applied := adder(35, null);
    let twice := apply_twice(5, adder);

    let safe := unsafe_demo(16);
    let second := comptime nth<1>(10, 20, 30);
    let enum_text := comptime enum_name<Ordering>(Ordering::Greater);

    static_assert(sizeof(Ordering) == 1, "Ordering must be byte-sized");

    comptime {
        static_assert(FACT_10 == 3628800,
                      "factorial is evaluated at compile time");
        println("compile-time checks complete");
    }

    println("version: ", VERSION);
    println("distance: ", distance);
    println("total: ", total);
    println("largest: ", largest);
    println("top: ", top);
    println("shared size: ", shared_size);
    println("written: ", written);
    println("moved size: ", moved_size);
    println("consumed: ", consumed);
    println("json: ", json);
    println("port: ", port);
    println("name: ", display_name);
    println("block: ", block_value);
    println("sign: ", sign);
    println("doubled: ", doubled);
    println("applied: ", applied);
    println("twice: ", twice);
    println("safe: ", safe);
    println("second: ", second);
    println("enum: ", enum_text);
    println("fields: ", account_fields().len());
    println("control: ", control_flow_demo(-3));

    return 0;
}
