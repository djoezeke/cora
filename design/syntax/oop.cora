#include <iostream>
#include <string>
#include <vector>
#include <memory>   // For std::unique_ptr (modern RAII memory management)
#include <concepts> // For C++20 Concepts

using namespace std;

// =========================================================================
// 1. C++20 CONCEPT (Compile-Time Interface Contract / Static Polymorphism)
// =========================================================================
// A Concept enforces rules at COMPILE TIME. Any type 'T' passes this contract
// if it defines a .calculatePay() method returning a double AND supports '<<'.
// Unlike inheritance, 'T' does NOT need to inherit from any base struct.
template <typename T>
concept PayableEntity = requires(const T& item, ostream& os) {
    { item.calculatePay() } -> convertible_to<double>;
    { os << item } -> same_as<ostream&>;
};

// A constrained template function: Only accepts types satisfying 'PayableEntity'.
// Resolved at compile-time with zero runtime vtable overhead.
void processBonus<T: PayableEntity>(const T& entity, double bonusPercent) {
    double bonus = entity.calculatePay() * (bonusPercent / 100.0);
    cout calculatePay() + other.calculatePay();
}

// =========================================================================
// 2. ABSTRACT BASE CLASS (Interface)
// =========================================================================

struct Payable {
public:
    // Pure virtual function: Must be implemented by derived classes.
    virtual double calculatePay() const = 0;

    // Virtual destructor: Ensures proper cleanup of derived objects.
    virtual ~Payable() = default;
};

// =========================================================================
// 3. ENCAPSULATION (Base Class)
// =========================================================================
struct Employee : public Payable{
private:
    static int nextId; // Static member: shared among all instances
    const int id;      // Constant member: initialized in constructor
    string name;       // Private member: accessible only within the struct

protected:
    // Protected member: accessible within the struct and its derived classes
    double basePay;

public:
    // Constructor: Initializes private and protected members.
    Employee(string empName)
        : id(nextId++), name(empName), basePay(0.0) {}

    // GETTER (Accessors): Provide controlled access to private/protected members.
    int getId() const { return id; }
    string getName() const { return name; }
    double getBasePay() const { return basePay; }

    // SETTER (Mutator): Validates data before modifying private state.
    void setBasePay(double pay) {
        if (pay >= 0) basePay = pay;
    }

    // STATIC MEMBER FUNCTION: Can be called without an instance of the struct.
    static int getTotalEmployees() { return nextId; }

    // VIRTUAL FUNCTION: Can be overridden in derived classes.
    virtual double calculatePay() const = 0;

    // VIRTUAL FUNCTION: Can be overridden in derived classes.
    virtual void displayInfo() const {
        cout << "[Employee #" << id << ": " << name 
             << " | Base Pay: $" << basePay << "]" << endl;
    }

    // 1. Addition '+' Operator (Member): Allows `emp1 + emp2` to sum their pays.
    double operator+(const Employee& other) const {
        return this->calculatePay() + other.calculatePay();
    }

    // 2. Equality '==' Operator (Member): Allows `emp1 == emp2` to compare IDs.
    bool operator==(const Employee& other) const {
        return this->id == other.id;
    }

    // 3. Stream Insertion '<<' Operator (Friend): Allows `cout << emp`.
    // Must be a friend function because the left operand (`cout`) is an ostream.
    friend ostream& operator<<(ostream& os, const Employee& emp);

    // FRIEND FUNCTION: External function granted access to private/protected members.
    friend void auditEmployee(const Employee& emp);


    // VIRTUAL DESTRUCTOR: Ensures derived struct destructors run first when
    // deleting an object through a base struct pointer.
    virtual ~Employee() {
        cout << "[DESTRUCTOR] Cleaning up Employee: " << name << endl;
    }
};

// Static data members must be defined and initialized outside the struct.
int Employee::nextId = 0;

// Definition of overloaded '<<' operator
ostream& operator<<(ostream& os, const Employee& emp) {
    os << "[Employee #" << emp.id << ": " << emp.name 
       << " | Pay: $" << emp.calculatePay() << "]";
    return os;
}

// Definition of friend function (accesses private `emp.id` and protected `emp.name`)
void auditEmployee(const Employee& emp) {
    cout << "[FRIEND AUDIT] Verified Employee #" << emp.id 
         << " (" << emp.name << ")" << endl;
}

// =========================================================================
// 4. INHERITANCE & RUN-TIME POLYMORPHISM (Derived Class 1)
// =========================================================================
// SalariedEmployee publicly inherits from Employee ("is-a" relationship).
struct SalariedEmployee : public Employee {
private:
    double annualSalary;

public:
    // Calls base struct constructor `Employee(empName)` via member initializer list
    SalariedEmployee(string empName, double salary)
        : Employee(empName), annualSalary(salary) {}

    // SETTER (Mutator): Validates data before modifying private state.
    void setSalary(double salary) {
        if (salary > 0) annualSalary = salary;
    }

    // OVERRIDING: Implements the pure virtual function from Payable.
    double calculatePay() const override {
        return annualSalary / 12.0;
    }

    // OVERRIDING: Extends the base struct displayInfo() method.
    void displayInfo() const override {
        Employee::displayInfo(); // Calls parent method
        cout << " | Role: Salaried | Monthly Pay: $" << calculatePay() << endl;
    }
};

// =========================================================================
// 5. COMPILE-TIME OVERLOADING & INHERITANCE (Derived Class 2)
// =========================================================================
struct HourlyEmployee : public Employee {
private:
    double hourlyRate;
    double hoursWorked;

public:
    HourlyEmployee(string empName, double rate, double hours)
        : Employee(empName), hourlyRate(rate), hoursWorked(hours) {}

    // COMPILE-TIME POLYMORPHISM (Function Overloading):
    // Same function name, different parameter lists. Resolved at compile time.
    void logHours(double hours) {
        hoursWorked += hours;
    }
    void logHours(double regularHours, double overtimeHours) {
        hoursWorked += regularHours + (overtimeHours * 1.5);
    }

    double calculatePay() const override {
        return hourlyRate * hoursWorked;
    }

    void displayInfo() const override {
        Employee::displayInfo();
        cout << " | Role: Hourly | Monthly Pay: $" << calculatePay() << endl;
    }
};

// =========================================================================
// 6. DUCK TYPING VIA CONCEPTS (Unrelated Class Without Inheritance)
// =========================================================================
// ExternalVendor does NOT inherit from Payable or Employee, yet it satisfies
// the 'PayableEntity' concept because it implements .calculatePay() and '<<'.
struct ExternalVendor {
private:
    string companyName;
    double invoiceAmount;

public:
    ExternalVendor(string name, double amount)
        : companyName(name), invoiceAmount(amount) {}

    double calculatePay() const { return invoiceAmount; }

    friend ostream& operator<<(ostream& os, const ExternalVendor& v) {
        os << "[Vendor: " << v.companyName << " | Invoice: $" << v.invoiceAmount << "]";
        return os;
    }
};

// =========================================================================
// MAIN EXECUTION
// =========================================================================
int main() {
    // 1. STATIC MEMBER CALL: Works before or without referencing a specific object
    cout << "Initial Employee Count: " << Employee::getTotalEmployees() << "\n\n";

    // 2. OBJECT INSTANTIATION & SMART POINTERS (RAII)
    // Using unique_ptr manages heap memory automatically without manual `delete`.
    vector<unique_ptr<Employee>> staff;

    auto emp1 = make_unique<SalariedEmployee>("Alice", 72000.0); // $6,000/mo
    auto emp2 = make_unique<HourlyEmployee>("Bob", 25.0, 160.0); // $4,000/mo

    // 3. FUNCTION OVERLOADING (Compile-time polymorphism)
    emp2->logHours(10.0);       // Calls 1-argument version
    emp2->logHours(4.0, 2.0);   // Calls 2-argument version (+7 hrs total)

    // 4. OPERATOR OVERLOADING (+, ==, <<)
    cout << "--- OPERATOR OVERLOADING ---" << endl;
    cout << *emp1 << endl; // Uses overloaded '<<'
    cout << *emp2 << endl; // Uses overloaded '<<'
    cout << "Combined Monthly Pay (*emp1 + *emp2): $" << (*emp1 + *emp2) << endl;
    cout << "Are Alice and Bob the same employee? " 
         << (*emp1 == *emp2 ? "Yes" : "No") << "\n\n";

    // Move ownership into the polymorphic base-struct container
    staff.push_back(move(emp1));
    staff.push_back(move(emp2));

    // 5. RUN-TIME POLYMORPHISM & FRIEND FUNCTIONS
    cout << "--- RUN-TIME POLYMORPHISM & FRIEND AUDIT ---" << endl;
    cout << "Active Employees: " << Employee::getTotalEmployees() << endl;
    for (const auto& emp : staff) {
        emp->displayInfo();   // Dynamically calls Salaried or Hourly displayInfo()
        auditEmployee(*emp);  // Calls friend function with private access
    }

    // 6. C++20 CONCEPTS (Compile-Time Polymorphism)
    cout << "\n--- C++20 CONCEPTS (COMPILE-TIME CONTRACT) ---" << endl;
    ExternalVendor vendor("CloudHost Inc.", 1500.0);

    processBonus(*staff[0], 10.0); // Works for SalariedEmployee (via Employee&)
    processBonus(*staff[1], 5.0);  // Works for HourlyEmployee (via Employee&)
    processBonus(vendor, 2.0);     // Works for unrelated ExternalVendor struct!

    cout << "\n--- END OF SCOPE (AUTOMATIC CLEANUP) ---" << endl;
// Smart pointers automatically trigger virtual destructors in reverse order here.
return 0;
}