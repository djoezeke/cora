// Structs: data + behavior in one place
// Encapsulation: Every member is private by default, (pub) on a field, or function exposes it visibility.

struct Point {
    x: f64, // private (default)
    y: f64, // private (default)
    pub z: ztype, // public visibility

    using xtype = f64;
    using ytype = f64;
    pub using ztype = f64;

    pub func new(x: f64, y: f64) -> Point {
        return Point { x: x, y: y, z: 0.0 }
    }

    // private visibility default
    func new() -> Point {
        return new(0.0, 0.0);
    }

    // public visibility
    pub func(self: &Point) len2() -> f64 {
        return self.x*self.x + self.y*self.y + self.z*self.z
    }

    // private helper
    func(self: &mut Point) renormalize() {
    }
}

// =========================================================================
// Traits (interfaces): Struct without data and only function declarations.
// =========================================================================

// Interface (struct with only signatures):
struct Shape {
    func area(self) -> f64; // abstract — no body
    func name(self) -> str { return "shape" }  // default not allowed
}

// Conformance via C++ colon:
struct Circle : Shape {
    pub r: f64,
    pub func area(self) -> f64 { return 3.14159 * self.r * self.r }
}

// Concepts via comptime:
comptime func is_shape(T: type) -> bool {
    return has_func(T, "area", (T) -> f64);
}

comptime func ShapeLike(T: type) -> bool {
    // richer contract: area, plus non-negative area property can't be checked statically
    // but we can check for name() with default, or other funcs
    return has_func(T, "area", (T) -> f64)
        and (has_func(T, "name", (T) -> str) or default_present(T, "name"));
}

// =========================================================================
// Comptime Functions : Static/Compile-Time polymorphism 
// =========================================================================

struct Circle {
    r: f64,

    pub func(c: &Circle) area() -> f64 {
        return 3.14159 * c.r * c.r;
    }
}

struct Square {
    x: f64,

    pub func area(self) -> f64 {
        return c.x * c.x;
    }    
}

// =========================================================================
// Generics : Static/Compile-Time polymorphism 
// =========================================================================

struct Shape {
    func(s: &Shape) area() -> f64;                             // required
    func(s: &Shape) name() -> str { return "shape"; }          // default
    func(s: &Shape) describe() -> str {                        // default, uses others
        return s.name() + " area=" + str(s.area());
    }
}

struct Circle : Shape {
    r: f64,

    pub func(c: &Circle) area() -> f64 {
        return 3.14159 * c.r * c.r;
    }
}

struct Square : Shape {
    x: f64,

    pub func(s: &Square) area() -> f64 {
        return s.x * s.x;
    }    
}

func area<T: Shape>(s: T) -> f64 {
    return s.area();
}

func area(s: dyn Shape) -> f64 {
    return s.area();
}

// =========================================================================
// Tag Union : Dynamic/Runtime polymorphism 
// =========================================================================
// When the concrete set is closed, prefer a tagged union. 
// This is "runtime polymorphism" with static dispatch via match.
// =========================================================================

struct Circle {
    r: f64,

    pub func(c: &Circle) area() -> f64 {
        return 3.14159 * c.r * c.r;
    }
}

struct Square {
    x: f64,

    pub func(s: &Square) area() -> f64 {
        return s.x * s.x;
    }    
}

enum Shape {
    Circle(Circle),
    Square(Square),
}

func area(s: Shape) -> f64 {
    match(s) {
        Circle(c) => c.area(),
        Square(q) => q.area(),
    }
}

// =========================================================================
// Fat Pointer (dyn) : Dynamic/Runtime polymorphism 
// =========================================================================
// dyn Trait is a fat pointer — (data ptr, vtable ptr).
// It is the only thing that produces a vtable, and only when you write it.
// =========================================================================

struct Shape {
    func(s: &Shape) area() -> f64;                             // abstract — no body, required
    func(s: &Shape) name() -> str { return "shape"; }          // default body allowed
    func(s: &Shape) describe() -> str {                        // default, uses others
        return s.name() + " area=" + str(s.area());
    }
}

struct Circle : Shape {
    r: f64,

    pub func(c: &Circle) area() -> f64 {
        return 3.14159 * c.r * c.r;
    }
}

struct Square : Shape {
    x: f64,

    pub func(s: &Square) area() -> f64 {
        return s.x * s.x;
    }    
}

let c: Circle = Circle { r: 2.0 }
let r: Rect   = Rect   { w: 3.0, h: 4.0 }

let s1: dyn Shape = c as dyn Shape     // explicit opt-in
let s2: dyn Shape = r as dyn Shape

let shapes: []dyn Shape = [s1, s2]
for (let s : shapes) {
    s.area() // vtable dispatch
}    

// =========================================================================
// Inheritance via Composition
// =========================================================================

struct Engine {
    pub hp: u32,
    pub func start(self) { ... }
}

struct Car {
    pub engine: Engine,             // has-a, not is-a
    pub func start(self) { self.engine.start() }
}

struct Truck {
    pub engine: Engine,
    pub func start(self) { self.engine.start() }
}

// =========================================================================
// Enums over class hierarchies
// =========================================================================
// Polymorphic families are modeled as closed variants, not subclasses.
// =========================================================================

enum Token {
    Ident(str),
    Number(f64),
    Keyword(Kw),
    Eof,
}

// =========================================================================
// Example 
// =========================================================================

struct Shape {
    pub func(s: &Shape) area() -> f64;
    func(s: &Shape) name() -> str { return "shape" }
}

struct Drawable {
    pub func(d: &Drawable) draw() -> void;
}

// Compound interface.
struct ShapeDrawable : Shape, Drawable {}

struct Circle : ShapeDrawable {
    pub r: f64,

    pub func(c: &Circle) area() -> f64 { return 3.14159 * self.r * self.r }
    pub func(c: &Circle) draw() -> void { ... }
}

struct Rect : ShapeDrawable {
    pub w: f64, 
    pub h: f64,

    pub func(r: &Rect) area() -> f64 { return self.w * self.h }
    pub func(r: &Rect) name() -> str { return "rect" }
    pub func(r: &Rect) draw() -> void { ... }
}

// Concept — compile-time contract, richer than the interface names.
comptime func is_ShapeDrawable<T>(t: T) -> bool {
    return has_func(t, "area", func(T) -> f64)
       && has_func(t, "draw", func(&T))
       && is_copy(t);
}

// (a) compile-time, interface bound, multiple interfaces via comma
func describe<T: Shape, Drawable>(x: T) -> str {
    x.draw();
    return x.name() + " area=" + str(x.area())
}

// (b) compile-time, concept bound
func describe2<T: is_ShapeDrawable>(x: T) -> str {
    x.draw();
    return x.name() + " area=" + str(x.area())
}

// (c) opt-in runtime, compound fat pointer
func describe_dyn(xs: []dyn ShapeDrawable) {
    for x in xs {
        x.draw();
        print(x.name(), x.area());
    }
}

func main() -> void {
    describe(Circle { r: 1.0 });
    describe2(Rect { w: 2.0, h: 3.0 });

    let xs: []dyn ShapeDrawable = [
        Circle { r: 1.0 } as dyn ShapeDrawable,
        Rect   { w: 2.0, h: 3.0 } as dyn ShapeDrawable,
    ];
    describe_dyn(xs);
}


// =========================================================================
// Example 
// =========================================================================

struct Shape {
    pub func(s: &Shape) area() -> f64;
}

struct Drawable {
    pub func(d: &Drawable) draw() -> void;
}

struct ShapeDrawable : Shape, Drawable {}

struct Circle : ShapeDrawable {
    pub r: f64,

    pub func(c: &Circle) area() -> f64 { return 3.14159 * self.r * self.r }
    pub func(c: &Circle) draw() -> void { ... }
}

struct Rect : ShapeDrawable {
    pub w: f64, 
    pub h: f64,

    pub func(r: &Rect) area() -> f64 { return self.w * self.h }
    pub func(r: &Rect) draw() -> void { ... }
}

struct Container {
    shape: dyn ShapeDrawable,
}


func main() -> void {
    let a: ShapeDrawable = dyn Circle { r: 2.0 };
    let b: ShapeDrawable = dyn Rect   { w: 3.0, h: 4.0 };

    let xs: []dyn ShapeDrawable = [
        dyn Circle { r: 1.0 },
        dyn Rect   { w: 2.0, h: 3.0 },
    ]

    for x in xs {
        x.draw();                // vtable slot from Drawable
        print(x.area());         // vtable slot from Shape
    }

    let c = Circle { r: 2.0 }
    let v: &dyn ShapeDrawable = dyn &c
    let as_shape:  dyn Shape    = dyn c.clone()   // only Shape's methods
    let as_full:   dyn ShapeDrawable = dyn c      // Shape + Drawable

    let k = Container {
        shape: dyn Circle { r: 2.0 },     // inferred from field type
    }

    // Errors — what is rejected and why
    let a = dyn Circle { r: 2.0 }              // error: no expected type
    let a: Circle = dyn Circle { r: 2.0 }      // error: expected type is not dyn I
    let a: dyn ShapeDrawable = Circle { r: 2.0 }  // error: no implicit coercion
    let v: &dyn ShapeDrawable = dyn Circle { r: 2.0 } // error: expected `&T`, found `T`; try `dyn &Circle { r: 2.0 }`
    let x: dyn ShapeDrawable = dyn Circle { r: 2.0 } // dyn-to-dyn casts are not allowed; start from a concrete value
    let y: dyn Serializable = dyn x // error: `dyn ShapeDrawable` is not `T : Serializable`

}
