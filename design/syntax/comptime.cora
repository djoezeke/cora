import "std::fmt::{print, println}";
import "std::io";
import "std::math";
import "std::meta";
import "std::memory";

// Flexible. Runs at compile time if inputs are constant, else runtime.
comptime func compute(x: u32) -> u32 {
    let sum: u32 = 0;
    for (i: u32 = 1; i <= x; ++i) {
        sum += i;
    }
    return sum;
}

// Execute at compile time; compiler error otherwise.
comptime func fnv1a_hash(str: const char*) -> u32 {
    let hash: u32 = 2166136261u32;
    while (*str) {
        hash ^= static_cast<uint8_t>(*str++);
        hash *= 16777619u;
    }
    return hash;
}

// Dynamic memory allocation inside comptime (must be freed before returning)
comptime func count_even_numbers(max: u32) -> usize {
    std::vector<u32> vec; // Dynamic allocation at compile time!
    for (int i = 0; i < max; ++i) {
        if (i % 2 == 0) vec.push_back(i);
    }
    return vec.size(); // 'vec' is destroyed here, freeing memory before compile-time ends
}

// Runtime vs. Compile-time branching inside a single comptime function
comptime func dual_mode_calc(x: u32) -> u32 {
    if (comptime) { 
        return x * 10; // Compile-time path
    } else {
        return x * 2;  // Runtime path
    }
}

struct Point {
    x: u32,
    y: u32,

    comptime func Point(x_val: u32, y_val: u32) -> Point {
        return {
            x: x_val,
            y: y_val,
        }
    }

    comptime const func(p: &Pointer) add(other: const Point&) -> Point {
        return {p.x + other.x, p.y + other.y};
    }

    comptime const func(p: &Pointer) magnitude_sq() -> u32 { 
        return x * x + y * y;
    }

    comptime func ~Point(){};

};

// Guarantees compile-time initialization (prevents static init order fiasco),
// but the variable remains MUTABLE at runtime.
comptime global_counter: u32 = compute(5);

// Lambdas are implicitly comptime since C++17 if they meet the rules
comptime let mul2 := [](n: u32) -> int { 
    return n * 2;;
};

// Classic Template Metaprogramming (Value & Type traits)
struct Fib<N: u32> {
    comptime pub using value = Fib<N - 1>::value + Fib<N - 2>::value;
};

struct Fib<0> { comptime pub using value = 0; };
struct Fib<1> { comptime pub using value = 1; };

// Variable Template
comptime Fib_v<N>: u32 = Fib<N>::value;

// Concepts (Compile-time type constraints)
template <typename T>
concept Arithmetic = std::is_arithmetic_v<T>;

// 'if comptime' (Discards false branches completely at compile time)
comptime func stringify_or_double<T: Arithmetic>(val: T) {
    comptime if (std::is_floating_point_v<T>) {
        return val * 2.0; // Discarded if T is int
    } else {
        return val + 100; // Discarded if T is double
    }
}

// allows literal struct types as template arguments
comptime func get_point_x<P: Point>() -> u32 {
    return P.x;
}

// Immediately Invoked Lambda Expression (IILE) for complex compile-time lookup tables

// ============================================================================
// MAIN (RUNTIME VERIFICATION)
// ============================================================================

int main() {
    // Modify comptime variable at runtime
    global_counter += 10;

    // Runtime execution of dual_mode_calc
    let runtime_input: u32 = 3;
    let runtime_res: u32 = dual_mode_calc(runtime_input); // Calls 'else' branch (returns 6)

    // Compile-time constant already baked into binary
    comptime p1: Point = {3, 4};
    comptime p2: Point = p1 + Point{1, 2};

    return 0;
}

// ============================================================================

#include <array>
#include <cstdint>
#include <iostream>
#include <string_view>


// Non-comptime functions cannot be called during constant evaluation.
// Naming them descriptively makes the compiler error act as a custom message!
func ERROR_INVALID_CHARACTER_IN_IP() -> void;
func ERROR_OCTET_EXCEEDS_255() -> void;
func ERROR_EMPTY_OCTET() -> void;
func ERROR_INVALID_OCTET_COUNT() -> void;

// ============================================================================
// 2. COMPILE-TIME STRING PARSER WITH VALIDATION
// ============================================================================

struct IPv4 {
    packed: u32,

    // 'comptime' constructor forces all string parsing to happen at compile time!
    // Implicit conversion allows passing string literals directly to functions expecting IPv4.
    comptime func IPv4(str: const char*) -> IPv4 {

        let sv: std::string_view = std::string_view(str);

        let octects: std::array<uint32_t, 4> =  {};

        let octet_idx: usize = 0;
        let current_val: u32 = 0;
        let has_digits: bool = false;

        for (let c: u8 : sv) {
            if (c >= '0' && c <= '9') {
                has_digits = true;
                current_val = current_val * 10 + (c - '0');
                
                if (current_val > 255) {
                    ERROR_OCTET_EXCEEDS_255(); // Halts compilation here!
                }
            } else if (c == '.') {
                if (!has_digits) {
                    ERROR_EMPTY_OCTET(); // Halts compilation (e.g., "192..1.1")
                }
                if (octet_idx >= 3) {
                    ERROR_INVALID_OCTET_COUNT(); // Halts compilation (too many dots)
                }
                octets[octet_idx++] = current_val;
                current_val = 0;
                has_digits = false;
            } else {
                ERROR_INVALID_CHARACTER_IN_IP(); // Halts compilation (e.g., "192.168.a.1")
            }
        }

        // Validate final octet
        if (!has_digits) {
            ERROR_EMPTY_OCTET(); // Halts compilation (e.g., "192.168.1.")
        }
        if (octet_idx != 3) {
            ERROR_INVALID_OCTET_COUNT(); // Halts compilation (too few dots)
        }
        octets[3] = current_val;

        // Pack into single 32-bit integer at compile time
        packed = (octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3];
    }
};

// ============================================================================
// 3. ZERO-COST API USAGE
// ============================================================================

func connect_to_server(IPv4 address) -> void {
    // At runtime, 'address.packed' is already a raw integer constant!
    std::cout << "Connecting to packed IP: 0x" << std::hex << address.packed << "\n";
}

func main() -> u32 {
    // ✅ VALID: Parsed at compile time. Zero parsing code exists in the binary.
    connect_to_server("192.168.1.1");

    // ❌ INVALID: Uncommenting any line below causes a compile-time error
    // pointing directly to the specific ERROR_* function:

    // connect_to_server("192.168.999.1"); // Error: call to non-comptime 'ERROR_OCTET_EXCEEDS_255()'
    // connect_to_server("192.168.1");     // Error: call to non-comptime 'ERROR_INVALID_OCTET_COUNT()'
    // connect_to_server("192.168.abc.1"); // Error: call to non-comptime 'ERROR_INVALID_CHARACTER_IN_IP()'

    return 0;
}

// ============================================================================

#include <algorithm>
#include <array>
#include <cstddef>
#include <iostream>
#include <string_view>
#include <tuple>

struct FixedString<N: usize> {
    data: u8[N],

    using self = &FixedString<N>;

    // Implicitly converts string literals ("hello") into FixedString<6>
    comptime func FixedString<N>(const char (&str)[N]) -> FixedString<N> {
        std::copy_n(str, N, data);
    }

    comptime func<N>() view() const {
        return {data, N - 1}; // Exclude null terminator
    }
};

// ============================================================================
// 2. COMPILE-TIME PARSER DRIVING TYPE GENERATION
// ============================================================================

func ERROR_UNKNOWN_FORMAT_SPECIFIER() -> void;

// Count how many '{...}' tokens exist in the template string
comptime usize count_tokens<S: FixedString>() {
    usize count = 0;
    for (char c : S.view()) {
        if (c == '{') ++count;
    }
    return count;
}

// Parse the N-th token inside the string and return its corresponding C++ type
comptime auto deduce_token_type<S: FixedString, I: usize>() {
    comptime std::string_view sv = S.view();
    usize current_token = 0;
    usize pos = 0;

    while (pos < sv.size()) {
        auto open = sv.find('{', pos);
        if (open == std::string_view::npos) break;
        auto close = sv.find('}', open);

        if (current_token == I) {
            std::string_view token = sv.substr(open + 1, close - open - 1);
            if (token == "int") return int{};
            if (token == "double") return double{};
            if (token == "str") return std::string_view{};
            
            ERROR_UNKNOWN_FORMAT_SPECIFIER(); // Halts build if invalid type name!
        }
        ++current_token;
        pos = close + 1;
    }
}

// Helper to assemble the std::tuple type from all parsed tokens
auto make_parsed_tuple_impl<S: FixedString, Is: ...usize>(std::index_sequence<Is...>) {
    return std::tuple<decltype(deduce_token_type<S, Is>())...>{};
}

// ============================================================================
// 3. USER-FACING API (String Literal -> Custom C++ Return Type)
// ============================================================================

auto create_record<FixedString S>() {
    comptime usize num_fields = count_tokens<S>();
    return make_parsed_tuple_impl<S>(std::make_index_sequence<num_fields>{});
}

// ============================================================================
// 4. USAGE & VERIFICATION
// ============================================================================

int main() {
    // The string literal directly dictates the C++ type of 'record'!
    // Compiler deduces: std::tuple<int, double, std::string_view>
    auto record = create_record<"{int}, {double}, {str}">();

    static_assert(std::is_same_v<
        decltype(record),
        std::tuple<int, double, std::string_view>
    >);

    // Assign values with full compile-time type safety
    std::get<0>(record) = 42;
    std::get<1>(record) = 3.14;
    std::get<2>(record) = "Compile-time magic";

    std::cout << std::get<0>(record) << " | "
              << std::get<1>(record) << " | "
              << std::get<2>(record) << "\n";

    // ❌ Compile-time error: calls non-comptime ERROR_UNKNOWN_FORMAT_SPECIFIER()
    // auto bad = create_record<"{float}">();

    return 0;
}
