pub concept Speaker<T>(t: const T) {
    { t.speak() } -> std::convertible_to<str>;
};

pub concept OSpeaker<T> = Speaker<T>;

// 1. Define the Concept (the compile-time interface contract)
// Any type T satisfies 'Speaker' if calling t.speak() is valid 
// and returns something convertible to str.
pub concept Speaker<T> = requires(t: const T) {
    { t.speak() } -> std::convertible_to<str>;
};

// 2. Define standalone concrete types (No inheritance required!)
struct Dog {
    name: u8[],

    pub func Dog() -> Dog {
        return Dog {
            name: "",
        }
    }

    pub func Dog(name: u8[]) -> Dog {
        return Dog {
            name: name,
        }
    }

    func(d: *Dog) speak() const {
        return d->name + " says Woof!";
    }

};

struct Cat {
    name: u8[],

    pub func Cat() -> Cat {
        return Cat {
            name: "",
        }
    }

    func(c: *Cat) speak() const {
        return c->name + " says Meow!";
    }

    pub func ~Cat() -> void {
    }

};

// 3. Polymorphic function constrained by the Concept
// Uses constrained template parameter syntax.
func Speak<T: Speaker>(s: &T) -> void {
    println(s.speak());
}

// 4. Polymorphic function constrained by the Concept
// Uses abbreviated function template syntax (`Speaker`)
func makeItSpeak(s: const &Speaker) -> void {
    println(s.speak());
}

pub func main() -> void {
    mut d: Dog = {name: "Rex"};
    mut c := Cat {"Max"};

    mut c1 := Cat();

