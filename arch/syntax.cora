// ============================================================================
// Function Template
// ============================================================================

func max<T>(a: T, b: T) -> T {
    return (a > b) ? a : b;
}

func max<T>(a: T, b: T) -> T {
    return (a > b) ? a : b;
}

max(10, 20); // Deduce u32
max(1,.0, 2.0); // Deduce f32
max<i32>(10,20); 

// ============================================================================
// class Template
// ============================================================================

struct Box<T> {
    value: T,

    pub func init(v: T) -> Box<T> {
        return {value: v };
    }
};

struct Box<T>/ {
    value: T,

    pub func init(v: T) : value(v) -> Box<T> {}
    pub func getVAlue() -> T { return value;}
};

type Box<T> = struct {
    value: T,

    pub func init(v: T) -> Box<T> {
        return {value: v };
    }
}box;

impl Box<T> {

    pub func init(v: T) -> Box<T> {
        return {value: v };
    }

    pub func init(v: T) -> Box<T> {
        return {value: v };
    }

    pub func(b: &Box<T) getVAlue() -> T {
        return b.value;
    }

    pub func(b: *Box<T) getVAlue() -> T {
        return b->value;
    }
}

const intbox : Box<i32> = Box::init(42);
// Usage: intbox.getValue();

// ============================================================================
// Concept & Constraint
// ============================================================================

// Concepts
// ============================================================================

// 1. Define the Concept (the compile-time interface contract)
// Any type T satisfies 'Speaker' if calling t.speak() is valid 
// and returns something convertible to cora::string.

comptime type Speaker<T> = struct(t: const T) {
    { t.speak() } -> cora::convertible_to<cora::string>;
}

type Speaker<T> = impl_speak<T>;

func impl_speak<T>(t: const T) -> void {
    { t.speak() } -> cora::convertible_to<cora::string>;
}

func impl_cout<T>(t: const T) -> void {
    { t.speak() } -> cora::convertible_to<cora::string>;
}

// Constraint
// ============================================================================

// 2. Define standalone concrete types (No inheritance required!)
type Dog = struct {
    name: u8[],
}

impl Dog {

    pub func(d: &Dog) speak() -> T {
        return d.name + " says Woof!";
    }
}

type Cat = struct {
    name: u8[],
}

impl Cat {

    pub func(c: &Cat) speak() -> T {
        return c.name + " says Meow!";
    }
}

// 3. Polymorphic function constrained by the Concept
func speak<T: Speaker>(s: &T) -> void {
    return s.speak();
}

func main() -> void {
    const d :=  Dog{ name:"Rex"};
    const c: Cat = { name:"Tex"};

    // Compiler generates specialized, inlined functions for Dog and Robot
    speak(d);
    speak(r);
}

// ============================================================================
//  Pack Indexing
// ============================================================================

// Extract the Nth type directly
template <std::size_t I, typename... Ts>
using NthType<I: std::size_t, TS: ...> = TS...[I];

// Extract the Nth argument directly without recursion 
comptime func getNthArg<I: std::size_t, Args: ...any>(args: ...Args&&) -> any {
    return args...[I];
}

// ============================================================================
// Static Reflection & Expansion Statements
// ============================================================================

// Generic enum-to-string converter for any enum type
comptime func enumToString<E: is_enum_v<E>>(e: E) -> u8[] {
     for (e : cora::meta::enumerators_of(^^E)) {
        if (value == [:e:]) {
            return cora::meta::identifier_of(e);
        }
    }
    return "unknown";
}

