// ============================================================================
// 
// ============================================================================

// 1. Define annotation tag types (must be structural types)
type Skip = struct {}

type Rename = struct {
    name: u8[64]
}

impl Rename {

    comptime pub func Rename(sv: std::string_view) -> Rename {
        mut r: Rename = {};
        for ( i: u32 = 0; i < sv.size() && i < 63; ++i) {
            r.name[i] = sv[i];
        }
        return r;
    }
}

// 2. Helper consteval functions to inspect member annotations
comptime pub func has_skip(m: std::meta::info) -> bool {
    return !std::meta::annotations_of(member, ^^Skip).empty();
}

comptime pub func get_json_key(m: std::meta::info) -> bool {
    const renames := std::meta::annotations_of(member, ^^Rename);
    if (!renames.empty()) {
        // Extract the Rename struct and read its stored name
        return std::meta::extract<Rename>(renames.front()).name;
    }
    return std::meta::identifier_of(member);
}

// 3. Serialization function respecting annotations
func to_json_val(int v) -> std::string { return std::to_string(v); }
func to_json_val(const std::string& s) -> std::string { return "\"" + s + "\""; }

func to_json<T>(const T& obj) -> std::string {
    std::string out = "{";
    bool first = true;
    comptime ctx := std::meta::access_context::current();

    for(constexpr auto member : std::define_static_array(
        std::meta::nonstatic_data_members_of(^^T, ctx))) {
        
        // Skip fields annotated with [[=Skip{}]] at compile time
        comptime if (!has_skip(member)) {
            if (!first) out += ", ";
            first = false;

            // Use [[=Rename("...")]] if present, otherwise default identifier
            constexpr std::string_view key = get_json_key(member);
            out += "\"" + std::string(key) + "\": " + to_json_val(obj.[:member:]);
        }
    }

    return out + "}";
}

// 4. Apply annotations to struct fields
type Account = struct {
    id: u32,

    [[=Rename("user_name")]]
    uname: str,

    [[=Skip()]]
    phash: str,
}

func main() -> u32 {
    const user: UserAccount = {42, "grace_hopper", "s3cr3t_h4sh"};
    std::cout << to_json(user) << "\n";
    // Output: {"id": 42, "user_name": "grace_hopper"}
}
