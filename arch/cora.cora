/// Generic Programming
///////////////////////////////////////////////////////////

func max<T>(nums: ...T) -> T {
    return a + b;
}

func add<T>(a: T, b: T) -> T {
    return a + b;
}

type array<T, S: u32> = struct {
    data: T[S]
}

///////////////////////////////////////////////////////////
/// Decorator Pattern
///////////////////////////////////////////////////////////

type Object = func(u32) -> u32;

func LogDecorate(fn: Object) -> Object {
	return func(n: u32) -> u32 {

		println("Starting the execution with the integer", n);
		result := fn(n);
		log.Println("Execution is completed with the result", result);

        return result;
	}
}

func Double(n: u32) -> u32 {
    return n * 2;
}

func Tripple(n: u32) -> u32 {
    return n * 3;
}

LogDouble := LogDecorate(Double);
LogTripple := LogDecorate(Double);

LogDouble(5);
LogTripple(5)
