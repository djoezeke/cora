import (
	std::fmt::{println, writeln};
	std::sys;
	std::log;
)

var (
    id: i32 = 20;
    pos: i32 = 10;
)

const (
    max: i32 = 20;
    min: i32 = 10;
)

type (
	Status = enum {
		Passed,
        Failed
	}

	Event = struct {
		data: i64
	}

	Observer = interface {
		func OnNotify(Event) -> none ;
	}

	Notifier = interface {
		func Register(Observer) -> none;
		func Deregister(Observer) -> none;
		func Notify(Event) -> none;
	}
)

