/// 
///////////////////////////////////////////////////////////

trait Shape {
    type Pos =  u32[2];

    func draw(s: &Surface) -> void;
}

type Rect = struct {
    width: u32,
    height: u32,
}

impl Rect {
    func(r: &Rect) area() -> u32 {
        r.width * r.height
    }
}

impl Shape for Rect {
    func(r: &Rect) draw(s: &Surface) -> void {
        r.width * r.height
    }
}

