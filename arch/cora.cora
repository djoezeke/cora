/// Unions

type Value = union {}

/// Structures

type User = struct {
    public using a_type = T;
    private using b_type = T;

    id: u64,
    age: u32
}

const zeke: User = {id: 1, age:21}

func(u: *User) getID() -> u64 {
    return u->id;
}

const zeke_id: u32 = zeke.getID();

func(u: *User) getIDPlus<T>(T: inc) -> T {
    return u->id + inc;
}

const zeke_id: u32 = zeke.getIDPlus<u32>(23);

comptime type User<T,S> = struct {
    id: T,
    age: S
}

const czeke: User<i32,i32> = {id: 1, age:21}

comptime func(u: *User<T,S>) getID() -> T {
    return u->id;
}

const zeke_id:= czeke.getID();

comptime func (u: *User<T,S>) getIDPlus<X>(X: inc) -> X {
    return u->id + inc;
}

const zeke_id:= czeke.getIDPlus(23);

