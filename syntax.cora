import "std::io::scan";
import <std::io::scan>;

// Compound Types

// Array
const a = [1, 2, 3, 4, 5];
mut a: u32[5] = [1, 2, 3, 4, 5];
mut a: u32[2][2] = [[1,1],
                    [2,2]];

// Control Flow

// If Expression

type Point = struct {
    x: u32,
    y: u32,
}

func max(a: u32, b: u32) -> u32 {
    if a > b { a } else { b }
}

func main() -> u32 {
    const a: Point = Point{x: 2, y: 3};
    const b: u32 = max(a.x, a.y);   // 3
    return a.x + a.y;
}