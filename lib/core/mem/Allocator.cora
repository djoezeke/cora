//! The standard dynamic memory allocation interface.
//!
//! `Allocator` is a fat pointer: a context pointer plus a vtable pointer.
//! Concrete allocators expose the same operations as ordinary methods, which
//! gives static dispatch when used directly and dynamic dispatch when wrapped
//! in `Allocator`.

pub struct Allocator {
    //! The operations every allocator implements.
    pub struct VTable {
        pub alloc: *const func(ctx: *mut void, size: usize, align: usize) -> *mut u8,
        pub realloc: *const func(ctx: *mut void, ptr: *mut u8,
                                 old_size: usize, new_size: usize,
                                 align: usize) -> *mut u8,
        pub free: *const func(ctx: *mut void, ptr: *mut u8,
                              size: usize, align: usize) -> void,
    };

    ctx: *mut void,
    vtable: *const VTable,

    pub func Allocator(ctx: *mut void, vtable: *const VTable) -> Allocator {
        return Allocator {
            ctx: ctx,
            vtable: vtable,
        };
    }

    pub func(self: &Allocator) is_null() -> bool {
        return self.vtable == null;
    }

    pub func(self: &Allocator) alloc(size: usize, align: usize) -> *mut u8 {
        if (self.is_null()) {
            return null;
        }
        return self.vtable.alloc(self.ctx, size, align);
    }

    pub func(self: &Allocator) realloc(ptr: *mut u8, old_size: usize,
                                       new_size: usize, align: usize) -> *mut u8 {
        if (self.is_null()) {
            return null;
        }
        return self.vtable.realloc(self.ctx, ptr, old_size, new_size, align);
    }

    pub func(self: &Allocator) free(ptr: *mut u8, size: usize,
                                    align: usize) -> void {
        if (self.is_null() || ptr == null) {
            return;
        }
        self.vtable.free(self.ctx, ptr, size, align);
    }

    //! Allocate storage for `count` values of `T`.
    pub func(self: &Allocator) alloc_array<T>(count: usize) -> *mut T {
        return self.alloc(count * sizeof(T), alignof(T)) as *mut T;
    }

    //! Release storage previously returned by `alloc_array<T>`.
    pub func(self: &Allocator) free_array<T>(ptr: *mut T,
                                             count: usize) -> void {
        self.free(ptr as *mut u8, count * sizeof(T), alignof(T));
    }
}
