//! A growable contiguous vector.

import "core::base::Option";
import "core::mem::Allocator";
import "core::mem::GPAllocator";

pub struct Vector<T, A: Allocator<T>> {
    data: *mut T,
    length: usize,
    capacity: usize,
    allocator: A,

    /*!
     * @brief  Creates an empty vector.
     * @param  allocator  An allocator object.
     */
    pub func Vector(allocator: &const A) -> Vector<T, A> {
        return Vector<T, A> {
            data: null,
            length: 0,
            capacity: 0,
            allocator: allocator,
        };
    }

    pub func(self: &Vector<T, A>) len() -> usize {
        return self.length;
    }

    pub func(self: &Vector<T, A>) cap() -> usize {
        return self.capacity;
    }

    pub func(self: &Vector<T, A>) is_empty() -> bool {
        return self.length == 0;
    }

    pub func(self: &Vector<T, A>) data_ptr() -> *mut T {
        return self.data;
    }

    pub func(self: &Vector<T, A>) allocator_ref() -> &A {
        return &self.allocator;
    }

    pub func(self: &mut Vector<T, A>) reserve(min_capacity: usize) -> bool {
        if (min_capacity <= self.capacity) {
            return true;
        }

        let mut new_capacity := if (self.capacity == 0) {
            min_capacity
        } else {
            self.capacity
        };
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }

        let old_bytes := self.capacity * sizeof(T);
        let new_bytes := new_capacity * sizeof(T);
        let raw := if (self.data == null) {
            self.allocator.alloc(new_bytes, alignof(T))
        } else {
            self.allocator.realloc(self.data as *mut u8, old_bytes,
                                   new_bytes, alignof(T))
        };

        if (raw == null) {
            return false;
        }

        self.data = raw as *mut T;
        self.capacity = new_capacity;
        return true;
    }

    pub func(self: &mut Vector<T, A>) push(value: T) -> bool {
        if (!self.reserve(self.length + 1)) {
            return false;
        }
        self.data[self.length] = value;
        self.length += 1;
        return true;
    }

    pub func(self: &mut Vector<T, A>) pop() -> Option<T> {
        if (self.length == 0) {
            return Option<T>::None;
        }
        self.length -= 1;
        return Option<T>::Some(self.data[self.length]);
    }

    pub func(self: &Vector<T, A>) get(index: usize) -> Option<&T> {
        if (index >= self.length) {
            return Option<&T>::None;
        }
        return Option<&T>::Some(&self.data[index]);
    }

    pub func(self: &mut Vector<T, A>) get_mut(index: usize) -> Option<&mut T> {
        if (index >= self.length) {
            return Option<&mut T>::None;
        }
        return Option<&mut T>::Some(&mut self.data[index]);
    }

    pub func(self: &mut Vector<T, A>) set(index: usize, value: T) -> bool {
        if (index >= self.length) {
            return false;
        }
        self.data[index] = value;
        return true;
    }

    pub func(self: &mut Vector<T, A>) insert(index: usize,
                                             value: T) -> bool {
        if (index > self.length) {
            return false;
        }
        if (!self.reserve(self.length + 1)) {
            return false;
        }

        let mut cursor := self.length;
        while (cursor > index) {
            self.data[cursor] = self.data[cursor - 1];
            cursor -= 1;
        }

        self.data[index] = value;
        self.length += 1;
        return true;
    }

    pub func(self: &mut Vector<T, A>) remove(index: usize) -> Option<T> {
        if (index >= self.length) {
            return Option<T>::None;
        }

        let value := self.data[index];
        let mut cursor := index;
        while (cursor + 1 < self.length) {
            self.data[cursor] = self.data[cursor + 1];
            cursor += 1;
        }
        self.length -= 1;
        return Option<T>::Some(value);
    }

    pub func(self: &mut Vector<T, A>) truncate(new_length: usize) -> void {
        if (new_length < self.length) {
            self.length = new_length;
        }
    }

    pub func(self: &mut Vector<T, A>) clear() -> void {
        self.length = 0;
    }

    pub func(self: &mut Vector<T, A>) deinit() -> void {
        if (self.data != null) {
            self.allocator.free(self.data as *mut u8,
                                self.capacity * sizeof(T),
                                alignof(T));
        }
        self.data = null;
        self.length = 0;
        self.capacity = 0;
    }

    pub func ~Vector() -> void {
        self.deinit();
    }
}

using GPVector<T> = Vector<T, GPAllocator>;
using DynamicVector<T> = Vector<T, Allocator>;
