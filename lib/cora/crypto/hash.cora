/*!
 * @file hash.cora
 * @brief Hashing primitives and message digests.
 *
 * The module contains small, dependency-free implementations of FNV-1a,
 * CRC-32, and SHA-256.  The first two are intended for hash tables and
 * integrity checks; SHA-256 is the cryptographic hash used by the key
 * derivation helpers in `cora::crypto::keys`.
 *
 * All hashing operates on explicit byte ranges so the caller retains control
 * over allocation and string representation.
 */

import "core::type";

/*!
 * @brief Identifies a hash algorithm.
 */
pub enum HashAlgorithm {
    Fnv1a64,  //!< 64-bit Fowler-Noll-Vo hash.
    Crc32,    //!< CRC-32 (IEEE 802.3 polynomial).
    Sha256,   //!< SHA-256 cryptographic digest.
}

/*!
 * @brief Reasons a hashing operation may fail.
 */
pub enum HashError {
    InvalidLength,  //!< The requested digest length is unsupported.
    InvalidState,   //!< The hasher is in an inconsistent state.
}

/*!
 * @brief A fixed-capacity message digest.
 *
 * The storage can hold any digest produced by this module; `length` records
 * how many bytes are meaningful.  Digests are value types and can be copied
 * freely.
 */
pub struct Digest {
    bytes: u8[64],
    length: usize,

    /*!
     * @brief Creates an empty digest.
     * @return A digest with zero length.
     */
    pub func Digest() -> Digest {
        let mut digest := Digest {
            bytes: [0; 64],
            length: 0,
        };
        return digest;
    }

    /*!
     * @brief Creates a digest from a byte range.
     * @param source The digest bytes.
     * @param count The number of bytes, at most 64.
     * @return The copied digest, truncated to 64 bytes.
     */
    pub func from_bytes(source: *const u8, count: usize) -> Digest {
        let mut digest := Digest();
        let limit := if (count < 64) { count } else { 64 };
        let mut index := 0;
        while (index < limit) {
            digest.bytes[index] = source[index];
            index += 1;
        }
        digest.length = limit;
        return digest;
    }

    /*!
     * @brief Creates an eight-byte big-endian digest from a 64-bit value.
     * @param value The value to encode.
     * @return The encoded digest.
     */
    pub func from_u64(value: u64) -> Digest {
        let mut digest := Digest();
        let mut index := 0;
        while (index < 8) {
            digest.bytes[index] = (value >> ((7 - index) * 8)) as u8;
            index += 1;
        }
        digest.length = 8;
        return digest;
    }

    /*!
     * @brief Creates a four-byte big-endian digest from a 32-bit value.
     * @param value The value to encode.
     * @return The encoded digest.
     */
    pub func from_u32(value: u32) -> Digest {
        let mut digest := Digest();
        let mut index := 0;
        while (index < 4) {
            digest.bytes[index] = (value >> ((3 - index) * 8)) as u8;
            index += 1;
        }
        digest.length = 4;
        return digest;
    }

    /*!
     * @brief Returns the number of digest bytes.
     * @return The digest length.
     */
    pub func(self: &Digest) len() -> usize {
        return self.length;
    }

    /*!
     * @brief Returns `true` when the digest contains no bytes.
     * @return Whether the digest length is zero.
     */
    pub func(self: &Digest) is_empty() -> bool {
        return self.length == 0;
    }

    /*!
     * @brief Returns a pointer to the digest bytes.
     * @return The first digest byte.
     */
    pub func(self: &Digest) bytes() -> *const u8 {
        return &self.bytes[0] as *const u8;
    }

    /*!
     * @brief Returns the digest as a big-endian 64-bit word.
     * @return The first eight bytes interpreted as an unsigned integer.
     */
    pub func(self: &Digest) word() -> u64 {
        let mut value: u64 = 0;
        let limit := if (self.length < 8) { self.length } else { 8 };
        let mut index := 0;
        while (index < limit) {
            value = (value << 8) | self.bytes[index] as u64;
            index += 1;
        }
        return value;
    }

    /*!
     * @brief Compares two digests without early exit.
     * @param other The digest to compare against.
     * @return `true` when the lengths and contents match.
     */
    pub func(self: &Digest) equals(other: Digest) -> bool {
        if (self.length != other.length) {
            return false;
        }
        let mut difference: u8 = 0;
        let mut index := 0;
        while (index < self.length) {
            difference |= self.bytes[index] ^ other.bytes[index];
            index += 1;
        }
        return difference == 0;
    }

    /*!
     * @brief Copies the digest bytes into caller storage.
     * @param destination The destination buffer.
     * @param capacity The destination capacity.
     * @return The number of bytes copied.
     */
    pub func(self: &Digest) copy_to(destination: *mut u8,
                                    capacity: usize) -> usize {
        let limit := if (self.length < capacity) { self.length } else {
            capacity
        };
        let mut index := 0;
        while (index < limit) {
            destination[index] = self.bytes[index];
            index += 1;
        }
        return limit;
    }

    /*!
     * @brief Encodes the digest as lowercase hexadecimal text.
     * @param output The output buffer.
     * @param capacity The output capacity.
     * @return The number of characters written.
     */
    pub func(self: &Digest) to_hex(output: *mut u8,
                                   capacity: usize) -> usize {
        return hex_encode(*self, output, capacity);
    }
}

/*!
 * @brief The 64-bit Fowler-Noll-Vo (FNV-1a) hash.
 */
pub struct Fnv1a64 {
    state: u64,

    /*!
     * @brief Creates a hasher primed with the FNV offset basis.
     * @return A new FNV-1a hasher.
     */
    pub func Fnv1a64() -> Fnv1a64 {
        return Fnv1a64 { state: 0xCBF29CE484222325 };
    }

    /*!
     * @brief Hashes a byte range.
     * @param data The input bytes.
     * @param count The number of bytes.
     */
    pub func(self: &mut Fnv1a64) update(data: *const u8,
                                        count: usize) -> void {
        let mut index := 0;
        while (index < count) {
            self.state ^= data[index] as u64;
            self.state *= 0x100000001B3;
            index += 1;
        }
    }

    /*!
     * @brief Hashes a null-terminated string.
     * @param text The input string.
     */
    pub func(self: &mut Fnv1a64) update_cstr(text: *const u8) -> void {
        if (text == null) {
            return;
        }
        let mut index := 0;
        while (text[index] != 0) {
            self.state ^= text[index] as u64;
            self.state *= 0x100000001B3;
            index += 1;
        }
    }

    /*!
     * @brief Returns the accumulated hash.
     * @return The 64-bit FNV-1a value.
     */
    pub func(self: &Fnv1a64) finish() -> u64 {
        return self.state;
    }

    /*!
     * @brief Resets the hasher to its initial state.
     */
    pub func(self: &mut Fnv1a64) reset() -> void {
        self.state = 0xCBF29CE484222325;
    }
}

/*!
 * @brief CRC-32 using the IEEE 802.3 polynomial.
 */
pub struct Crc32 {
    state: u32,

    /*!
     * @brief Creates a CRC-32 accumulator.
     * @return A new CRC-32 hasher.
     */
    pub func Crc32() -> Crc32 {
        return Crc32 { state: 0xFFFFFFFF };
    }

    /*!
     * @brief Feeds a byte range into the checksum.
     * @param data The input bytes.
     * @param count The number of bytes.
     */
    pub func(self: &mut Crc32) update(data: *const u8,
                                      count: usize) -> void {
        let mut index := 0;
        while (index < count) {
            let mut value := self.state ^ data[index] as u32;
            let mut bit := 0;
            while (bit < 8) {
                if ((value & 1) != 0) {
                    value = (value >> 1) ^ 0xEDB88320;
                } else {
                    value = value >> 1;
                }
                bit += 1;
            }
            self.state = value;
            index += 1;
        }
    }

    /*!
     * @brief Hashes a null-terminated string.
     * @param text The input string.
     */
    pub func(self: &mut Crc32) update_cstr(text: *const u8) -> void {
        if (text == null) {
            return;
        }
        let mut index := 0;
        while (text[index] != 0) {
            let mut value := self.state ^ text[index] as u32;
            let mut bit := 0;
            while (bit < 8) {
                if ((value & 1) != 0) {
                    value = (value >> 1) ^ 0xEDB88320;
                } else {
                    value = value >> 1;
                }
                bit += 1;
            }
            self.state = value;
            index += 1;
        }
    }

    /*!
     * @brief Returns the finalized checksum.
     * @return The CRC-32 value.
     */
    pub func(self: &Crc32) finish() -> u32 {
        return ~self.state;
    }

    /*!
     * @brief Resets the checksum to its initial value.
     */
    pub func(self: &mut Crc32) reset() -> void {
        self.state = 0xFFFFFFFF;
    }
}

//! The SHA-256 round constants.
const SHA256_K: u32[64] = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
    0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
    0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
    0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
    0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
    0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
    0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
    0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
    0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
    0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
    0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
    0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
    0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
    0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
];

/*!
 * @brief An incremental SHA-256 hasher.
 */
pub struct Sha256 {
    state: u32[8],
    buffer: u8[64],
    buffered: usize,
    total: u64,

    /*!
     * @brief Creates a hasher primed with the SHA-256 initial state.
     * @return A new SHA-256 hasher.
     */
    pub func Sha256() -> Sha256 {
        let mut hasher := Sha256 {
            state: [0; 8],
            buffer: [0; 64],
            buffered: 0,
            total: 0,
        };
        hasher.reset();
        return hasher;
    }

    /*!
     * @brief Rotates a 32-bit value right.
     * @param value The value to rotate.
     * @param amount The rotation amount.
     * @return The rotated value.
     */
    func rotate_right(value: u32, amount: u32) -> u32 {
        return (value >> amount) | (value << (32 - amount));
    }

    /*!
     * @brief The SHA-256 `Ch` function.
     * @param x The first input.
     * @param y The second input.
     * @param z The third input.
     * @return The chosen value.
     */
    func choose(x: u32, y: u32, z: u32) -> u32 {
        return (x & y) ^ (~x & z);
    }

    /*!
     * @brief The SHA-256 `Maj` function.
     * @param x The first input.
     * @param y The second input.
     * @param z The third input.
     * @return The majority value.
     */
    func majority(x: u32, y: u32, z: u32) -> u32 {
        return (x & y) ^ (x & z) ^ (y & z);
    }

    /*!
     * @brief The SHA-256 `Sigma0` function.
     * @param value The input word.
     * @return The mixed word.
     */
    func big_sigma0(value: u32) -> u32 {
        return Sha256::rotate_right(value, 2) ^
               Sha256::rotate_right(value, 13) ^
               Sha256::rotate_right(value, 22);
    }

    /*!
     * @brief The SHA-256 `Sigma1` function.
     * @param value The input word.
     * @return The mixed word.
     */
    func big_sigma1(value: u32) -> u32 {
        return Sha256::rotate_right(value, 6) ^
               Sha256::rotate_right(value, 11) ^
               Sha256::rotate_right(value, 25);
    }

    /*!
     * @brief The SHA-256 `sigma0` function.
     * @param value The input word.
     * @return The mixed word.
     */
    func small_sigma0(value: u32) -> u32 {
        return Sha256::rotate_right(value, 7) ^
               Sha256::rotate_right(value, 18) ^ (value >> 3);
    }

    /*!
     * @brief The SHA-256 `sigma1` function.
     * @param value The input word.
     * @return The mixed word.
     */
    func small_sigma1(value: u32) -> u32 {
        return Sha256::rotate_right(value, 17) ^
               Sha256::rotate_right(value, 19) ^ (value >> 10);
    }

    /*!
     * @brief Compresses the 64-byte input buffer into the state.
     */
    func process_block(self: &mut Sha256) -> void {
        let mut schedule: u32[64] = [0; 64];
        let mut index := 0;
        while (index < 16) {
            let offset := index * 4;
            schedule[index] = (self.buffer[offset] as u32) << 24 |
                              (self.buffer[offset + 1] as u32) << 16 |
                              (self.buffer[offset + 2] as u32) << 8 |
                              (self.buffer[offset + 3] as u32);
            index += 1;
        }
        while (index < 64) {
            schedule[index] = Sha256::small_sigma1(schedule[index - 2]) +
                              schedule[index - 7] +
                              Sha256::small_sigma0(schedule[index - 15]) +
                              schedule[index - 16];
            index += 1;
        }

        let mut a := self.state[0];
        let mut b := self.state[1];
        let mut c := self.state[2];
        let mut d := self.state[3];
        let mut e := self.state[4];
        let mut f := self.state[5];
        let mut g := self.state[6];
        let mut h := self.state[7];

        index = 0;
        while (index < 64) {
            let first := h + Sha256::big_sigma1(e) +
                         Sha256::choose(e, f, g) + SHA256_K[index] +
                         schedule[index];
            let second := Sha256::big_sigma0(a) +
                          Sha256::majority(a, b, c);
            h = g;
            g = f;
            f = e;
            e = d + first;
            d = c;
            c = b;
            b = a;
            a = first + second;
            index += 1;
        }

        self.state[0] += a;
        self.state[1] += b;
        self.state[2] += c;
        self.state[3] += d;
        self.state[4] += e;
        self.state[5] += f;
        self.state[6] += g;
        self.state[7] += h;
    }

    /*!
     * @brief Feeds a byte range into the hash.
     * @param data The input bytes.
     * @param count The number of bytes.
     */
    pub func(self: &mut Sha256) update(data: *const u8,
                                       count: usize) -> void {
        if (count == 0) {
            return;
        }
        self.total += count as u64;
        let mut offset := 0;
        while (offset < count) {
            let available := 64 - self.buffered;
            let remaining := count - offset;
            let take := if (remaining < available) { remaining } else {
                available
            };
            let mut index := 0;
            while (index < take) {
                self.buffer[self.buffered + index] = data[offset + index];
                index += 1;
            }
            self.buffered += take;
            offset += take;
            if (self.buffered == 64) {
                self.process_block();
                self.buffered = 0;
            }
        }
    }

    /*!
     * @brief Hashes a null-terminated string.
     * @param text The input string.
     */
    pub func(self: &mut Sha256) update_cstr(text: *const u8) -> void {
        if (text == null) {
            return;
        }
        let mut length := 0;
        while (text[length] != 0) {
            length += 1;
        }
        self.update(text, length);
    }

    /*!
     * @brief Finalizes the hash and returns its digest.
     * @return The 32-byte SHA-256 digest.
     */
    pub func(self: &mut Sha256) finish() -> Digest {
        let bit_length := self.total * 8;
        self.buffer[self.buffered] = 0x80;
        self.buffered += 1;
        if (self.buffered > 56) {
            while (self.buffered < 64) {
                self.buffer[self.buffered] = 0;
                self.buffered += 1;
            }
            self.process_block();
            self.buffered = 0;
        }
        while (self.buffered < 56) {
            self.buffer[self.buffered] = 0;
            self.buffered += 1;
        }

        let mut index := 0;
        while (index < 8) {
            self.buffer[56 + index] =
                (bit_length >> ((7 - index) * 8)) as u8;
            index += 1;
        }
        self.process_block();
        self.buffered = 0;

        let mut digest := Digest();
        index = 0;
        while (index < 8) {
            let value := self.state[index];
            digest.bytes[index * 4] = (value >> 24) as u8;
            digest.bytes[index * 4 + 1] = (value >> 16) as u8;
            digest.bytes[index * 4 + 2] = (value >> 8) as u8;
            digest.bytes[index * 4 + 3] = value as u8;
            index += 1;
        }
        digest.length = 32;
        return digest;
    }

    /*!
     * @brief Resets the hasher to its initial state.
     */
    pub func(self: &mut Sha256) reset() -> void {
        self.state[0] = 0x6A09E667;
        self.state[1] = 0xBB67AE85;
        self.state[2] = 0x3C6EF372;
        self.state[3] = 0xA54FF53A;
        self.state[4] = 0x510E527F;
        self.state[5] = 0x9B05688C;
        self.state[6] = 0x1F83D9AB;
        self.state[7] = 0x5BE0CD19;
        self.buffered = 0;
        self.total = 0;
    }
}

/*!
 * @brief HMAC-SHA-256 message authentication.
 */
pub struct HmacSha256 {
    inner: Sha256,
    outer: Sha256,

    /*!
     * @brief Creates an HMAC hasher from a key.
     * @param key The secret key bytes.
     * @param key_length The key length in bytes.
     * @return A keyed hasher.
     */
    pub func HmacSha256(key: *const u8, key_length: usize) -> HmacSha256 {
        let mut block: u8[64] = [0; 64];
        if (key_length > 64) {
            let mut key_hasher := Sha256();
            key_hasher.update(key, key_length);
            let key_digest := key_hasher.finish();
            key_digest.copy_to(&mut block[0] as *mut u8, 32);
        } else {
            let mut index := 0;
            while (index < key_length) {
                block[index] = key[index];
                index += 1;
            }
        }

        let mut pad: u8[64] = [0; 64];
        let mut index := 0;
        while (index < 64) {
            pad[index] = block[index] ^ 0x36;
            index += 1;
        }
        let mut inner := Sha256();
        inner.update(&pad[0] as *const u8, 64);

        index = 0;
        while (index < 64) {
            pad[index] = block[index] ^ 0x5C;
            index += 1;
        }
        let mut outer := Sha256();
        outer.update(&pad[0] as *const u8, 64);

        return HmacSha256 { inner: inner, outer: outer };
    }

    /*!
     * @brief Feeds authenticated data into the MAC.
     * @param data The input bytes.
     * @param count The number of bytes.
     */
    pub func(self: &mut HmacSha256) update(data: *const u8,
                                           count: usize) -> void {
        self.inner.update(data, count);
    }

    /*!
     * @brief Finalizes the MAC.
     * @return The 32-byte HMAC-SHA-256 digest.
     */
    pub func(self: &mut HmacSha256) finish() -> Digest {
        let inner_digest := self.inner.finish();
        self.outer.update(inner_digest.bytes(), inner_digest.len());
        return self.outer.finish();
    }
}

/*!
 * @brief Computes a digest with one of the supported algorithms.
 * @param algorithm The algorithm to use.
 * @param data The input bytes.
 * @param length The input length in bytes.
 * @return The resulting digest.
 */
pub func hash_bytes(algorithm: HashAlgorithm, data: *const u8,
                    length: usize) -> Digest {
    if (algorithm == HashAlgorithm::Fnv1a64) {
        let mut hasher := Fnv1a64();
        hasher.update(data, length);
        return Digest::from_u64(hasher.finish());
    }
    if (algorithm == HashAlgorithm::Crc32) {
        let mut hasher := Crc32();
        hasher.update(data, length);
        return Digest::from_u32(hasher.finish());
    }
    let mut hasher := Sha256();
    hasher.update(data, length);
    return hasher.finish();
}

/*!
 * @brief Hashes a null-terminated string.
 * @param algorithm The algorithm to use.
 * @param text The input string.
 * @return The resulting digest.
 */
pub func hash_cstr(algorithm: HashAlgorithm, text: *const u8) -> Digest {
    if (text == null) {
        return hash_bytes(algorithm, null, 0);
    }
    let mut length := 0;
    while (text[length] != 0) {
        length += 1;
    }
    return hash_bytes(algorithm, text, length);
}

/*!
 * @brief Compares two byte ranges without leaking their contents through
 *        timing.
 * @param left The first range.
 * @param right The second range.
 * @param count The number of bytes to compare.
 * @return `true` when both ranges are identical.
 */
pub func constant_time_eq(left: *const u8, right: *const u8,
                          count: usize) -> bool {
    let mut difference: u8 = 0;
    let mut index := 0;
    while (index < count) {
        difference |= left[index] ^ right[index];
        index += 1;
    }
    return difference == 0;
}

/*!
 * @brief Encodes a digest as lowercase hexadecimal text.
 * @param digest The digest to encode.
 * @param output The output buffer.
 * @param capacity The output capacity.
 * @return The number of characters written.
 */
pub func hex_encode(digest: Digest, output: *mut u8,
                    capacity: usize) -> usize {
    let alphabet := "0123456789abcdef";
    let mut written := 0;
    let mut index := 0;
    while (index < digest.len() && written + 2 <= capacity) {
        let value := digest.bytes[index];
        output[written] = alphabet[(value >> 4) as usize];
        output[written + 1] = alphabet[(value & 0x0F) as usize];
        written += 2;
        index += 1;
    }
    return written;
}
